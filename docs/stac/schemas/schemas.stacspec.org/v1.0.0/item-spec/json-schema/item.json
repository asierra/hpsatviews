{
  "$id": "https://schemas.stacspec.org/v1.0.0/item-spec/json-schema/item.json#",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/core"
    }
  ],
  "definitions": {
    "asset": {
      "allOf": [
        {
          "properties": {
            "description": {
              "title": "Asset description",
              "type": "string"
            },
            "href": {
              "format": "iri-reference",
              "minLength": 1,
              "title": "Asset reference",
              "type": "string"
            },
            "roles": {
              "items": {
                "type": "string"
              },
              "title": "Asset roles",
              "type": "array"
            },
            "title": {
              "title": "Asset title",
              "type": "string"
            },
            "type": {
              "title": "Asset type",
              "type": "string"
            }
          },
          "required": [
            "href"
          ],
          "type": "object"
        },
        {
          "$ref": "#/definitions/common_metadata"
        }
      ]
    },
    "assets": {
      "additionalProperties": {
        "$ref": "#/definitions/asset"
      },
      "description": "Links to assets",
      "title": "Asset links",
      "type": "object"
    },
    "common_metadata": {
      "allOf": [
        {
          "$ref": "basics.json"
        },
        {
          "$ref": "datetime.json"
        },
        {
          "$ref": "instrument.json"
        },
        {
          "$ref": "licensing.json"
        },
        {
          "$ref": "provider.json"
        }
      ]
    },
    "core": {
      "allOf": [
        {
          "$ref": "https://geojson.org/schema/Feature.json"
        },
        {
          "oneOf": [
            {
              "properties": {
                "bbox": {
                  "items": {
                    "type": "number"
                  },
                  "oneOf": [
                    {
                      "maxItems": 4,
                      "minItems": 4
                    },
                    {
                      "maxItems": 6,
                      "minItems": 6
                    }
                  ],
                  "type": "array"
                },
                "geometry": {
                  "$ref": "https://geojson.org/schema/Geometry.json"
                }
              },
              "required": [
                "geometry",
                "bbox"
              ],
              "type": "object"
            },
            {
              "properties": {
                "bbox": {
                  "not": {}
                },
                "geometry": {
                  "type": "null"
                }
              },
              "required": [
                "geometry"
              ],
              "type": "object"
            }
          ]
        },
        {
          "else": {
            "properties": {
              "collection": {
                "not": {}
              }
            }
          },
          "if": {
            "properties": {
              "links": {
                "contains": {
                  "properties": {
                    "rel": {
                      "const": "collection"
                    }
                  },
                  "required": [
                    "rel"
                  ]
                }
              }
            }
          },
          "properties": {
            "assets": {
              "$ref": "#/definitions/assets"
            },
            "id": {
              "description": "Provider item ID",
              "minLength": 1,
              "title": "Provider ID",
              "type": "string"
            },
            "links": {
              "description": "Links to item relations",
              "items": {
                "$ref": "#/definitions/link"
              },
              "title": "Item links",
              "type": "array"
            },
            "properties": {
              "allOf": [
                {
                  "$ref": "#/definitions/common_metadata"
                },
                {
                  "anyOf": [
                    {
                      "properties": {
                        "datetime": {
                          "not": {
                            "type": "null"
                          }
                        }
                      },
                      "required": [
                        "datetime"
                      ]
                    },
                    {
                      "required": [
                        "datetime",
                        "start_datetime",
                        "end_datetime"
                      ]
                    }
                  ]
                }
              ]
            },
            "stac_extensions": {
              "items": {
                "format": "iri",
                "title": "Reference to a JSON Schema",
                "type": "string"
              },
              "title": "STAC extensions",
              "type": "array",
              "uniqueItems": true
            },
            "stac_version": {
              "const": "1.0.0",
              "title": "STAC version",
              "type": "string"
            }
          },
          "required": [
            "stac_version",
            "id",
            "links",
            "assets",
            "properties"
          ],
          "then": {
            "properties": {
              "collection": {
                "description": "The ID of the STAC Collection this Item references to.",
                "minLength": 1,
                "title": "Collection ID",
                "type": "string"
              }
            },
            "required": [
              "collection"
            ]
          },
          "type": "object"
        }
      ]
    },
    "link": {
      "properties": {
        "href": {
          "format": "iri-reference",
          "minLength": 1,
          "title": "Link reference",
          "type": "string"
        },
        "rel": {
          "minLength": 1,
          "title": "Link relation type",
          "type": "string"
        },
        "title": {
          "title": "Link title",
          "type": "string"
        },
        "type": {
          "title": "Link type",
          "type": "string"
        }
      },
      "required": [
        "rel",
        "href"
      ],
      "type": "object"
    }
  },
  "description": "This object represents the metadata for an item in a SpatioTemporal Asset Catalog.",
  "title": "STAC Item",
  "type": "object"
}
